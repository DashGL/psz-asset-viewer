---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const effects = (await getCollection('effects')).sort((a, b) =>
  a.data.id.localeCompare(b.data.id)
);

const BLURB: Record<string, string> = {
  item_effects:
    'Attack, technique, photon blast and status effects — plus o0c_burst01..04, the player-placed trap balls.',
  item_global: 'Global item effects: level up, item use, teleport, shadows.',
  item_middle: 'Mid-tier technique effects.',
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Effects - PSZ Asset Viewer</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #0a0a0a; color: #fff; min-height: 100vh; padding: 2rem;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .container { max-width: 1400px; margin: 0 auto; }
      h1 {
        font-size: 2.5rem; margin-bottom: 0.5rem; font-family: 'Courier New', monospace;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      }
      .sub { color: #888; margin-bottom: 2rem; }
      .back-link {
        display: inline-block; margin-bottom: 1.5rem; padding: 0.5rem 1rem;
        background: #2a2a2a; border: 1px solid #333; border-radius: 4px;
        color: #fff; text-decoration: none;
      }
      .back-link:hover { background: #3a3a3a; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
      .card {
        display: block; padding: 1.25rem; background: #1a1a1a; border: 1px solid #333;
        border-radius: 8px; color: #fff; text-decoration: none; transition: border-color 0.2s;
      }
      .card:hover { border-color: #667eea; }
      .card h2 { font-size: 1.15rem; font-family: 'Courier New', monospace; margin-bottom: 0.35rem; }
      .card .count { color: #667eea; font-size: 0.9rem; }
      .card .blurb { color: #888; font-size: 0.85rem; margin-top: 0.5rem; line-height: 1.4; }
    </style>
  </head>
  <body>
    <div class="container">
      <a href={base} class="back-link">← Back</a>
      <h1>Effects</h1>
      <p class="sub">
        Models from the item archives — the only geometry outside the object and enemy sets.
      </p>
      <div class="grid">
        {effects.map(entry => {
          const id = entry.data.id;
          return (
            <a href={`${base}effects/${id}`} class="card">
              <h2>{id}</h2>
              <div class="count">{entry.data.modelCount} models</div>
              {BLURB[id] && <div class="blurb">{BLURB[id]}</div>}
            </a>
          );
        })}
      </div>
    </div>
  </body>
</html>
