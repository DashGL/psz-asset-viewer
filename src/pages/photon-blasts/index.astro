---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Get all photon blasts from the collection
const allPhotonBlasts = await getCollection('photon-blasts');

// Transform to match the expected structure
const photonBlasts = allPhotonBlasts.map(entry => {
  // Strip /index from the ID
  const cleanId = entry.id.replace('/index', '');
  return {
    name: cleanId,
    displayName: entry.data.displayName,
    animationCount: entry.data.animationCount
  };
});

// Sort by name
photonBlasts.sort((a, b) => a.displayName.localeCompare(b.displayName));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Photon Blasts - PSZ Asset Viewer</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #0a0a0a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        min-height: 100vh;
        padding: 2rem;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
      }

      .header {
        margin-bottom: 2rem;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #00d4aa 0%, #00b4d8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .header p {
        color: #aaa;
        font-size: 1.1rem;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        padding: 0.5rem 1rem;
        background: #2a2a2a;
        border: 1px solid #333;
        border-radius: 4px;
        color: #fff;
        text-decoration: none;
        transition: background 0.2s;
      }

      .back-link:hover {
        background: #3a3a3a;
      }

      .info-box {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 2rem;
        color: #aaa;
      }

      .info-box strong {
        color: #00d4aa;
      }

      .pb-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .pb-card {
        background: linear-gradient(135deg, #00d4aa22 0%, #00b4d822 100%);
        border: 1px solid #333;
        border-radius: 8px;
        padding: 1.5rem;
        text-decoration: none;
        color: #fff;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
      }

      .pb-card:hover {
        transform: translateY(-4px);
        border-color: #00d4aa;
        box-shadow: 0 8px 24px rgba(0, 212, 170, 0.2);
      }

      .pb-name {
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: #00d4aa;
      }

      .pb-stats {
        font-size: 0.9rem;
        color: #aaa;
        margin-top: auto;
      }

      .no-photon-blasts {
        text-align: center;
        padding: 4rem 2rem;
        color: #aaa;
      }

      .no-photon-blasts h2 {
        margin-bottom: 1rem;
      }

      .no-photon-blasts code {
        background: #1a1a1a;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href={`${base}/`} class="back-link">&larr; Back to Home</a>

      <div class="header">
        <h1>Photon Blasts</h1>
        <p>{photonBlasts.length} photon beasts available</p>
      </div>

      <div class="info-box">
        <strong>Photon Blasts</strong> are powerful summoned creatures that fight alongside players.
        Each has unique attack animations and abilities.
      </div>

      {photonBlasts.length === 0 ? (
        <div class="no-photon-blasts">
          <h2>No photon blasts found</h2>
          <p>Run <code>npm run processPhotonBlasts</code> to convert photon blast models.</p>
        </div>
      ) : (
        <div class="pb-grid">
          {photonBlasts.map(pb => (
            <a href={`${base}photon-blasts/${pb.name}`} class="pb-card">
              <div class="pb-name">{pb.displayName}</div>
              <div class="pb-stats">
                {pb.animationCount > 0 && `${pb.animationCount} animations`}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </body>
</html>
