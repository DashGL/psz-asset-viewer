---
import PhotonBlastViewer from '../../components/PhotonBlastViewer';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Generate static paths for all photon blasts
export async function getStaticPaths() {
  const allPhotonBlasts = await getCollection('photon-blasts');

  return allPhotonBlasts.map(entry => {
    // Strip /index from the ID
    const cleanId = entry.id.replace('/index', '');
    return {
      params: { photonblast: cleanId },
      props: {
        pbData: {
          name: cleanId,
          displayName: entry.data.displayName,
          animationCount: entry.data.animationCount
        }
      }
    };
  });
}

const { photonblast } = Astro.params;
const { pbData } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pbData.displayName} - PSZ Photon Blast Viewer</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #0a0a0a;
        color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        min-height: 100vh;
        padding: 2rem;
      }

      .container {
        max-width: 1400px;
        margin: 0 auto;
      }

      .header {
        margin-bottom: 2rem;
      }

      .header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #00d4aa 0%, #00b4d8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .header p {
        color: #aaa;
        font-size: 1.1rem;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        padding: 0.5rem 1rem;
        background: #2a2a2a;
        border: 1px solid #333;
        border-radius: 4px;
        color: #fff;
        text-decoration: none;
        transition: background 0.2s;
      }

      .back-link:hover {
        background: #3a3a3a;
      }

      .stats {
        display: flex;
        gap: 2rem;
        margin-bottom: 1rem;
        padding: 1rem;
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 8px;
      }

      .stat-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #aaa;
      }

      .stat-value {
        color: #00d4aa;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href={`${base}photon-blasts`} class="back-link">&larr; Back to Photon Blasts</a>

      <div class="header">
        <h1>{pbData.displayName}</h1>
        <p>Photon Blast Viewer</p>
      </div>

      <div class="stats">
        <div class="stat-item">
          <span>Animations:</span>
          <span class="stat-value">{pbData.animationCount}</span>
        </div>
      </div>

      <PhotonBlastViewer client:load pbName={photonblast} basePath={`${base}photon-blasts`} />
    </div>
  </body>
</html>
